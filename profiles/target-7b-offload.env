# Quality run of the OFFICE target model on the dev laptop. Qwen2.5-7B-Instruct Q4_K_M (~4.7 GB)
# does not fit in 3.3 GiB VRAM: Ollama splits layers between GPU and CPU RAM. Slow, but it gives
# eval numbers for the model the office would actually run. Needs ~2-3 GiB free RAM in WSL2;
# raise the WSL2 limit first if the host has the RAM (%UserProfile%\.wslconfig: [wsl2] memory=8GB).
# Load with:  set -a; . profiles/target-7b-offload.env; set +a
CGPRR_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
CGPRR_NUM_CTX=3072
CGPRR_NUM_PREDICT=768
CGPRR_LLM_CONCURRENCY=1
CGPRR_LLM_TIMEOUT_S=900
CGPRR_USE_DENSE=0
CGPRR_QA_MAX_TOKENS=384
CGPRR_QA_PASSAGE_TOKENS=900
