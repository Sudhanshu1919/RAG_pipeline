# Development profile: NVIDIA GTX 1650 Ti laptop (4,096 MiB VRAM, ~738 MiB held by the
# Windows display under WDDM -> ~3.3 GiB usable), WSL2 Ubuntu, 5.7 GiB RAM visible.
# Load with:  set -a; . profiles/dev-gtx1650ti.env; set +a
#
# Generator: Qwen3-4B-Instruct-2507 (Apache-2.0, non-thinking), Q4_K_M ~2.5 GB.
# KV cache (36 layers x 8 KV heads x 128 dim x K,V): ~144 KiB/token fp16, ~72 KiB/token q8_0.
# At 3,072 ctx with q8_0 KV: ~0.22 GiB. Weights + KV + compute buffers ~3.0 GiB < 3.3 GiB free.
# Worst shipped prompt ~1,284 tokens (summary) + 768 output cap -> 3,072 ctx leaves headroom;
# the client refuses (ContextOverflowError) rather than letting Ollama truncate silently.
CGPRR_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
CGPRR_NUM_CTX=3072
CGPRR_NUM_PREDICT=768
CGPRR_LLM_CONCURRENCY=1
CGPRR_LLM_TIMEOUT_S=300
# Dense retrieval off: bge-m3 (~1.2 GB) cannot stay resident beside the generator in 3.3 GiB, and
# swapping models per query thrashes. BM25 alone: gold passage in top-5 for 9/9 and 25/25.
CGPRR_USE_DENSE=0
# To use dense retrieval on this card anyway: CGPRR_USE_DENSE=1 CGPRR_EMBED_ON_CPU=1 (bge-m3 embeds queries on the
# CPU, ~0.1-0.3 s each; bulk index embedding runs on the GPU after the generator is unloaded).
CGPRR_EMBED_ON_CPU=1
CGPRR_QA_MAX_TOKENS=384
CGPRR_QA_PASSAGE_TOKENS=900
# Latency target for `cgprr eval qa` (p95 of one ask, ms). The eval exits with code 4 when it is missed.
CGPRR_SLO_ASK_P95_MS=10000

# Ollama server settings for this card (export in the shell that runs `ollama serve`):
#   OLLAMA_FLASH_ATTENTION=1 OLLAMA_KV_CACHE_TYPE=q8_0 OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1
