# Kaggle notebook: one NVIDIA T4 (16 GB, Turing sm_75, 320 GB/s, 70 W). Office target model.
# Load with:  set -a; . profiles/kaggle-t4-7b.env; set +a
#
# Qwen2.5-7B-Instruct Q4_K_M ~4.7 GB + bge-m3 ~1.2 GB + KV (8,192 ctx x 2 parallel, fp16,
# 28 layers x 4 KV heads x 128 x K,V = 56 KiB/token) ~0.9 GB + buffers ~1 GB  ->  ~8 GB of 15 GB.
# Both models stay resident (OLLAMA_MAX_LOADED_MODELS=2), so dense retrieval is on, as in the office.
#
# Ollama server settings (set where `ollama serve` runs; the Kaggle notebook does this):
#   CUDA_VISIBLE_DEVICES=0 OLLAMA_NUM_PARALLEL=2 OLLAMA_MAX_LOADED_MODELS=2 OLLAMA_FLASH_ATTENTION=1
#   On Turing, if the default CUDA 13 runner crashes ("CUDA error: shared object initialization
#   failed"), restart the server with OLLAMA_LLM_LIBRARY=cuda_v12.
CGPRR_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
CGPRR_EMBED_MODEL=bge-m3
CGPRR_USE_DENSE=1
CGPRR_NUM_CTX=8192
CGPRR_NUM_PREDICT=768
CGPRR_LLM_CONCURRENCY=2
CGPRR_LLM_TIMEOUT_S=300
CGPRR_QA_MAX_TOKENS=384
CGPRR_SLO_ASK_P95_MS=5000
CGPRR_GUARD_MODEL=llama-guard3:1b
