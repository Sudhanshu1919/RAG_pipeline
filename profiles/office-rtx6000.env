# Office target: single RTX 6000-class workstation GPU, 24 GB assumed (fits every generation).
CGPRR_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
CGPRR_EMBED_MODEL=bge-m3
CGPRR_USE_DENSE=1
CGPRR_NUM_CTX=8192
CGPRR_NUM_PREDICT=768
CGPRR_LLM_CONCURRENCY=4
CGPRR_LLM_TIMEOUT_S=120
CGPRR_QA_MAX_TOKENS=384
CGPRR_SLO_ASK_P95_MS=3000
# Optional build-time content classifier (~1 GB): ollama pull llama-guard3:1b
# CGPRR_GUARD_MODEL=llama-guard3:1b
# Ollama: OLLAMA_NUM_PARALLEL=4 OLLAMA_FLASH_ATTENTION=1 (or serve via vLLM: CGPRR_BACKEND=openai_compat)
